// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Crew {
  id         String   @id @default(uuid())
  name       String   @unique
  crewCode   String?  @unique
  fireCentre String?

  users      User[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id         String   @id @default(uuid())
  firstName  String
  lastName   String
  email      String?  @unique
  hashedPassword String?
  position   String?

  crewId     String?
  crew       Crew?    @relation(fields: [crewId], references: [id], onDelete: SetNull)

  timeEntries TimeEntry[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TimeEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      DateTime
  savedAt   DateTime?
  type      TimeType
  direction EntryType
  hours     Float

  notes     String?

  deletedAt DateTime?   // Soft delete support

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

enum TimeType {
  ETO
  CTO
}

enum EntryType {
  EARNED
  USED
}